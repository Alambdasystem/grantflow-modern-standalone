{
  "name": "grantflow-modern",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "next lint",
    "test:auth": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/auth-session.test.ts",
    "test:unit": "node --experimental-strip-types --loader ./tests/resolve-ts.mjs --test tests/auth-session.test.ts tests/dashboard.test.ts tests/email-decision-dashboard.test.ts tests/grants.test.ts tests/workflow-feedback.test.ts tests/honda-onboarding.test.ts",
    "type-check": "tsc --noEmit",
    "ui:flash:init": "npx shadcn@latest init -d",
    "ui:flash:add-core": "npx shadcn@latest add button card input textarea badge tabs table select dialog sheet"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query": "^5.56.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.441.0",
    "next": "^15.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.7",
    "shadcn": "^4.6.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.0",
