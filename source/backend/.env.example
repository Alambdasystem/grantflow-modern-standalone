ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:////data/grantflow-lab.db
UPLOAD_DIR=/data/uploads
INGESTION_STORAGE_DIR=/data/private_documents
SCREENSHOT_DIR=/data/screenshots
RUN_LEGACY_STARTUP_IMPORTS=false
ANTHESIS_IDENTITY_URL=https://identity.example.invalid/api/gfm/introspect
ANTHESIS_REVOKE_URL=https://identity.example.invalid/api/gfm/revoke
ANTHESIS_GFM_INTROSPECTION_SECRET=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
OLLAMA_URL=http://ollama:11434
DEFAULT_MODEL=llama3.2:latest
AI_PRELOAD_MODEL=true
AI_LOAD_TIMEOUT_SECONDS=180
AI_INFERENCE_TIMEOUT_SECONDS=180
