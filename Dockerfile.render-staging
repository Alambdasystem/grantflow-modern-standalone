# Infrastructure staging only; all API access remains closed until auth integration.
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS frontend
ENV NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=2048 GFM_BACKEND_URL=http://127.0.0.1:8001 GFM_DIST_DIR=.next
WORKDIR /frontend
COPY source/frontend/package.json source/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY source/frontend ./
RUN npm run build

FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 GFM_BACKEND_URL=http://127.0.0.1:8001 GFM_DIST_DIR=.next
WORKDIR /app
COPY requirements-lab.txt requirements-linux.lock.txt ./
RUN pip install --no-cache-dir -r requirements-lab.txt -c requirements-linux.lock.txt \
    && python -m playwright install --with-deps chromium \
    && apt-get update && apt-get install -y --no-install-recommends nginx libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 lab \
    && mkdir -p /data && chown lab:lab /data /ms-playwright
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
COPY --from=frontend --chown=lab:lab /frontend /frontend
COPY source/backend /app/backend
COPY source/automation /app/automation
COPY source/migration /app/migration
COPY source/scripts /app/scripts
COPY render-staging-supervise.py /opt/staging/supervise.py
COPY render-staging-nginx.conf /opt/staging/nginx.conf
COPY render-staging-login.html /opt/staging/login.html
COPY render-staging-entry.py /app/backend/staging_entry.py
ENV ENVIRONMENT=render-staging DEBUG=false RUN_LEGACY_STARTUP_IMPORTS=false AUTOMATION_WORKER_ENABLED=false INGESTION_LOCAL_WORKER_ENABLED=false \
    DATABASE_URL=sqlite+aiosqlite:////data/grantflow-staging.db UPLOAD_DIR=/data/uploads INGESTION_STORAGE_DIR=/data/private_documents SCREENSHOT_DIR=/data/screenshots GFM_BROWSER_PROFILE_DIR=/data/browser-profile
USER lab
EXPOSE 10000
CMD ["python", "/opt/staging/supervise.py"]
