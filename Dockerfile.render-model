FROM ollama/ollama@sha256:dea72d1e22270fe095b68fdf756d2b489d615643c5a2eaebbc5f569181e322d8
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
COPY render-model-runtime.py /opt/model-runtime.py
ENV OLLAMA_HOST=0.0.0.0:11434 OLLAMA_MODELS=/var/data/models OLLAMA_NUM_PARALLEL=1 OLLAMA_CONTEXT_LENGTH=4096 \
    DEFAULT_MODEL=llama3.2:latest EXPECTED_MODEL_DIGEST=a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72
EXPOSE 11434
ENTRYPOINT ["python3", "/opt/model-runtime.py"]
