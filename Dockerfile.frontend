FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS build
ENV NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=2048
WORKDIR /app
COPY source/frontend/package.json source/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY source/frontend ./
ARG GFM_BACKEND_URL=http://backend:8001
ENV GFM_BACKEND_URL=${GFM_BACKEND_URL} GFM_DIST_DIR=.next
RUN npm run build

FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 GFM_BACKEND_URL=http://backend:8001 GFM_DIST_DIR=.next
WORKDIR /app
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3002
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3002"]
