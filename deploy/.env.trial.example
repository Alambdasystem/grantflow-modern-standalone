# Copy to deploy/.env.trial on the target; never commit the real file.
# Review package only: .invalid placeholders MUST be replaced before startup.
BACKEND_IMAGE=grantflow-standalone-backend:review
FRONTEND_IMAGE=grantflow-standalone-frontend:review
TRIAL_HOST=grants.trial.invalid
TRIAL_BIND_IP=127.0.0.1
TRIAL_TLS_PORT=5443
PUBLIC_ORIGIN=https://grants.trial.invalid:5443
ALLOWED_ORIGINS=["https://grants.trial.invalid:5443"]
ANTHESIS_ALLOWED_HOSTS=["identity.private.invalid","email.private.invalid"]
ANTHESIS_IDENTITY_URL=https://identity.private.invalid/api/gfm/introspect
ANTHESIS_REVOKE_URL=https://identity.private.invalid/api/gfm/revoke
ANTHESIS_PLATFORM_ME_URL=https://identity.private.invalid/api/auth/me
ANTHESIS_EMAIL_SAFETY_BASE_URL=https://email.private.invalid/api/email-monitor/decision-dashboard/
ANTHESIS_LOGIN_HOST=identity.private.invalid
ANTHESIS_LOGIN_ORIGIN=https://identity.private.invalid
IDENTITY_KEY_FILE=../secrets/identity-service-key
ANTHESIS_CA_FILE=../secrets/anthesis-ca.pem
TLS_CERT_FILE=../secrets/trial-cert.pem
TLS_KEY_FILE=../secrets/trial-key.pem
OLLAMA_URL=http://ollama:11434
DEFAULT_MODEL=llama3.2:latest
EXPECTED_MODEL_DIGEST=a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72
DATA_VOLUME=grantflow-trial-data
MODEL_VOLUME=grantflow-trial-models
