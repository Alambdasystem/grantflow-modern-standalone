# Production Render values. Real secrets belong in Render Environment, not Git.
AUTH_MODE=standalone
ENVIRONMENT=render-standalone
PUBLIC_ORIGIN=https://grantflow-modern-staging.onrender.com
ALLOWED_ORIGINS=["https://grantflow-modern-staging.onrender.com"]
SESSION_SECURE=true
# Generate a unique >=32-character setup secret. Required before first startup.
GFM_BOOTSTRAP_TOKEN=
GFM_DATA_ROOT=/var/data
GFM_REQUIRE_PERSISTENT_STORAGE=true
DATABASE_URL=sqlite+aiosqlite:////var/data/grantflow.db
UPLOAD_DIR=/var/data/uploads
INGESTION_STORAGE_DIR=/var/data/private_documents
SCREENSHOT_DIR=/var/data/screenshots
GFM_BROWSER_PROFILE_DIR=/var/data/browser-profile
RUN_LEGACY_STARTUP_IMPORTS=false
DEBUG=false
AUTOMATION_WORKER_ENABLED=true
INGESTION_LOCAL_WORKER_ENABLED=true
AI_ENABLED=true
# Queue requirement analysis after associated files finish extraction.
# Held sources are analyzed as unverified drafts; this never approves them.
APPLICATION_SOURCE_AUTO_ANALYZE=true
AI_PROVIDER=alambda
ALAMBDA_CHAT_URL=https://api.alambda.com/api/chat
# Optional only when a service credential is provisioned by the remote operator.
ALAMBDA_API_TOKEN=
ALAMBDA_API_TOKEN_FILE=
ALAMBDA_MODEL=
AI_INFERENCE_TIMEOUT_SECONDS=120
# Render supplies PORT. Override only for a local production-image test.
PORT=10000
